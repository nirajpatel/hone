# =============================================================================
# Hone - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All VITE_ prefixed variables are exposed to the browser client.
# Never put true secrets (service role keys, API secrets) in VITE_ variables.
# =============================================================================

# ---------------------
# Supabase (required)
# ---------------------
# Find these in: Supabase Dashboard → Settings → API
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------
# La Marzocco (optional)
# ---------------------
# Feature gate: only show La Marzocco integration for specific users.
# Leave blank to disable the feature for everyone.
VITE_LAMARZOCCO_ALLOWED_USER_ID=
VITE_LAMARZOCCO_ALLOWED_HOUSEHOLD_ID=

# ---------------------
# Google Analytics (optional)
# ---------------------
# Set your GA4 measurement ID to enable analytics. Leave blank to disable.
VITE_GA_MEASUREMENT_ID=

# =============================================================================
# Supabase Edge Function Secrets
# =============================================================================
# These are NOT set in .env — they are configured in:
#   Supabase Dashboard → Settings → Edge Functions → Secrets
#
# SUPABASE_SERVICE_ROLE_KEY   - Service role key (from Dashboard → Settings → API)
# OPENAI_API_KEY              - OpenAI API key for brew suggestions
# GOOGLE_API_KEY              - Google API key (optional, for additional AI features)
# RESEND_API_KEY              - Resend API key for custom email sending
# SEND_EMAIL_HOOK_SECRET      - Webhook secret for send-email-hook (generate with: openssl rand -base64 32)
# TWILIO_ACCOUNT_SID          - Twilio account SID (optional, for SMS notifications)
# TWILIO_AUTH_TOKEN            - Twilio auth token (optional)
# TWILIO_PHONE_NUMBER          - Twilio phone number (optional)
# LAMARZOCCO_INSTALLATION_KEY - La Marzocco API key (optional)
# LAMARZOCCO_USERNAME          - La Marzocco account username (optional)
# LAMARZOCCO_PASSWORD          - La Marzocco account password (optional)
# SUPABASE_PROJECT_REF        - Your project ref (same as VITE_SUPABASE_PROJECT_ID)
